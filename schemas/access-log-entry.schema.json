{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterkarlhuber/software-audit/schemas/access-log-entry.schema.json",
  "title": "Access log entry (written by the file gateway, one JSON line per access)",
  "type": "object",
  "required": [
    "ts",
    "run_id",
    "agent",
    "repo",
    "op"
  ],
  "properties": {
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "run_id": {
      "type": "string"
    },
    "agent": {
      "type": "string"
    },
    "repo": {
      "type": "string"
    },
    "op": {
      "enum": [
        "list_dir",
        "read_file",
        "search"
      ]
    },
    "path": {
      "type": "string"
    },
    "start": {
      "type": "integer",
      "minimum": 1
    },
    "end": {
      "type": "integer",
      "minimum": 1
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bytes_returned": {
      "type": "integer",
      "minimum": 0
    },
    "pattern": {
      "type": "string"
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "op": {
            "const": "read_file"
          }
        }
      },
      "then": {
        "required": [
          "path",
          "start",
          "end",
          "file_sha256",
          "bytes_returned"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "op": {
            "const": "search"
          }
        }
      },
      "then": {
        "required": [
          "pattern",
          "matches"
        ]
      }
    }
  ]
}

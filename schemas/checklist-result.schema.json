{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Result of one checklist item",
  "type": "object",
  "required": [
    "id",
    "result",
    "evidence",
    "finding_ids",
    "reason"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+-[A-Z]+-[0-9]{2}$"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "N/A"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "lines": {
            "type": "string",
            "pattern": "^[0-9]+(-[0-9]+)?$"
          },
          "quote": {
            "type": "string"
          },
          "artifact": {
            "type": "string",
            "description": "Path of a tool output or test log in the run folder"
          }
        },
        "anyOf": [
          {
            "required": [
              "file",
              "lines",
              "quote"
            ]
          },
          {
            "required": [
              "artifact"
            ]
          }
        ]
      }
    },
    "finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reason": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "FAIL"
          }
        }
      },
      "then": {
        "properties": {
          "finding_ids": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "enum": [
              "UNKNOWN",
              "N/A"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "minLength": 3
          }
        }
      }
    }
  ]
}
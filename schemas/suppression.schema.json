{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterkarlhuber/software-audit/schemas/suppression.schema.json",
  "title": "List of suppressions (YAML, validated against this schema)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "match",
      "kind",
      "reason",
      "created_by",
      "created_at",
      "valid_until"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^SUP-[0-9]{4,}$"
      },
      "match": {
        "type": "object",
        "oneOf": [
          {
            "required": [
              "fingerprint"
            ]
          },
          {
            "required": [
              "rule_id",
              "path_pattern"
            ]
          }
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "rule_id": {
            "type": "string"
          },
          "path_pattern": {
            "type": "string"
          }
        }
      },
      "kind": {
        "enum": [
          "false_positive",
          "risk_accepted",
          "not_applicable"
        ]
      },
      "reason": {
        "type": "string",
        "minLength": 20
      },
      "created_by": {
        "type": "string"
      },
      "approved_by": {
        "type": [
          "string",
          "null"
        ]
      },
      "created_at": {
        "type": "string",
        "format": "date"
      },
      "valid_until": {
        "type": "string",
        "format": "date"
      },
      "verification_sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "kind": {
              "const": "risk_accepted"
            }
          }
        },
        "then": {
          "properties": {
            "approved_by": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    ]
  },
  "description": "Further rules the schema cannot express and the loader enforces: approved_by != created_by; validity at most 12 months (risk_accepted: 6); critical findings only with verification_sha256."
}

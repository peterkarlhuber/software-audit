{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterkarlhuber/software-audit/schemas/run-manifest.schema.json",
  "title": "Run manifest of an audit run",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "started_at",
    "target",
    "profile",
    "mode",
    "toolchain",
    "artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{6}-[A-Za-z0-9._-]+-[0-9a-f]{7}$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "target": {
      "type": "object",
      "required": [
        "repo",
        "commit",
        "prepare_status"
      ],
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "tree": {
          "type": "string"
        },
        "prepare_status": {
          "enum": [
            "ok",
            "rejected"
          ]
        },
        "prepare_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "profile": {
      "type": "object",
      "required": [
        "id",
        "version",
        "sha256"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "mode": {
      "type": "object",
      "required": [
        "exec",
        "network",
        "sandbox"
      ],
      "properties": {
        "exec": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        },
        "sandbox": {
          "enum": [
            "bubblewrap",
            "none"
          ]
        },
        "cgroups": {
          "type": "boolean"
        }
      }
    },
    "toolchain": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "version"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "ruleset": {
            "type": "string"
          },
          "ruleset_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "db_snapshot": {
            "type": "string"
          },
          "db_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "ai": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "agent",
          "provider",
          "model"
        ],
        "properties": {
          "stage": {
            "enum": [
              "reviewer",
              "chief",
              "verifier"
            ]
          },
          "agent": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "prompt_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "catalogue": {
      "type": "object",
      "properties": {
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "sealed_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}

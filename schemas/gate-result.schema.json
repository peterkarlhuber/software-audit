{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/peterkarlhuber/software-audit/schemas/gate-result.schema.json",
  "title": "Ergebnis des Freigabe-Gates",
  "type": "object",
  "required": [
    "run_id",
    "profile",
    "result",
    "violations",
    "unknown_checks",
    "risk_acceptances",
    "engine_version"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "profile": {
      "type": "string"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "INCOMPLETE"
      ]
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule",
          "detail"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "finding_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unknown_checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_acceptances": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs wirksamer Suppressions der Art risiko_akzeptiert"
    },
    "human_release": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "by",
        "at",
        "decision"
      ],
      "properties": {
        "by": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "decision": {
          "enum": [
            "freigegeben",
            "abgelehnt"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "engine_version": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "violations": {
            "maxItems": 0
          },
          "unknown_checks": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}

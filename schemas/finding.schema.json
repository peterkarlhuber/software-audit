{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Audit finding",
  "type": "object",
  "required": [
    "id",
    "checklist_id",
    "title",
    "severity",
    "status",
    "file",
    "lines",
    "quote",
    "impact",
    "recommendation"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^F-[0-9]{3,}$"
    },
    "checklist_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "severity": {
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "enum": [
        "confirmed",
        "plausible",
        "unverified",
        "not reproduced"
      ]
    },
    "file": {
      "type": "string",
      "description": "Relative to repo root; empty for repo-wide findings"
    },
    "lines": {
      "type": "string",
      "pattern": "^$|^[0-9]+(-[0-9]+)?$"
    },
    "quote": {
      "type": "string",
      "description": "Exact text from file; or tool/test output for repo-wide findings"
    },
    "source": {
      "enum": [
        "agent",
        "tool"
      ],
      "description": "Who raised the finding"
    },
    "tool": {
      "type": "string"
    },
    "impact": {
      "type": "string",
      "minLength": 3
    },
    "recommendation": {
      "type": "string",
      "minLength": 3
    },
    "test": {
      "type": "string",
      "description": "Path to the confirming test in the run folder"
    },
    "note": {
      "type": "string"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        }
      },
      "then": {
        "anyOf": [
          {
            "required": [
              "test"
            ]
          },
          {
            "properties": {
              "source": {
                "const": "tool"
              }
            },
            "required": [
              "source"
            ]
          }
        ]
      }
    }
  ]
}